# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# pour VPS - SECRETS SECURISES!

# ============================================
# SÉCURITÉ & JWT
# ============================================
# IMPORTANT: Générer avec: openssl rand -base64 32
JWT_SECRET=CHANGEZ_CETTE_CLE_SECURISEE_BASE64_32_CARACTERES_MINIMUM

# BASE DE DONNÉES
DB_USERNAME=bankadmin
DB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_STRONG_30_CHARS_MIN

# Noms des bases de données
AUTH_DB_NAME=auth_db
ACCOUNT_DB_NAME=account_db
TRANSACTION_DB_NAME=transaction_db

# RABBITMQ - MESSAGE BROKER
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=CHANGEZ_RABBITUSER_SECURISE
RABBITMQ_PASSWORD=CHANGEZ_RABBITPASS_SECURISE_FORT

# EMAIL / NOTIFICATIONS
# Brevo/Sendinblue pour l'envoi d'emails
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=VOTRE_EMAIL_BREVO@example.com
SMTP_PASSWORD=VOTRE_BREVO_SMTP_PASSWORD
NOTIFICATION_FROM_EMAIL=noreply@banking.local
BREVO_API_KEY=xkeysib-VOTRE_API_KEY_BREVO

# URLS INTERNES SERVICES (Docker network)
AUTH_SERVICE_URL=http://auth-service:8081
ACCOUNT_SERVICE_URL=http://account-service:8082
TRANSACTION_SERVICE_URL=http://transaction-service:8083

# DOCKER REGISTRY (pour images pré-construites)
# Format: registry.example.com/username
DOCKER_REGISTRY=YOUR_REGISTRY_URL
IMAGE_TAG=latest

# DOMAINE & SSL
DOMAIN=banking.example.com
SESSION_SECURE=true
ENVIRONMENT=production

# GRAFANA (Monitoring)
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEZ_GRAFANA_PASSWORD_SECURISE

# LOGGING & MONITORING
LOG_LEVEL=WARN
SENTRY_DSN=https://VOTRE_SENTRY_DSN@sentry.io/project-id
