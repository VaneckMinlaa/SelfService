# ============================================
# BANKING PORTAL - MICROSERVICES CONFIG
# ============================================
# Copy to .env and fill with actual values
# NEVER commit .env to git!

# ============================================
# SECURITY & JWT
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-here

# Database password for all PostgreSQL instances
DB_USERNAME=bankadmin
DB_PASSWORD=your-secure-database-password-here

# ============================================
# POSTGRESQL INSTANCES (One per service)
# ============================================
AUTH_DB_NAME=auth_db
ACCOUNT_DB_NAME=account_db
TRANSACTION_DB_NAME=transaction_db
AUDIT_DB_NAME=audit_db

# ============================================
# RABBITMQ (Message Broker)
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ============================================
# EMAIL / NOTIFICATIONS
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
NOTIFICATION_FROM_EMAIL=noreply@banking.local
BREVO_API_KEY=votre_cle_api_brevo_ici

# ============================================
# SERVICES URLS (Docker network)
# ============================================
AUTH_SERVICE_URL=http://auth-service:8081
ACCOUNT_SERVICE_URL=http://account-service:8082
TRANSACTION_SERVICE_URL=http://transaction-service:8083

# ============================================
# TLS/HTTPS (Self-signed certs)
# ============================================
SESSION_SECURE=false
DOMAIN=localhost

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=INFO
ENVIRONMENT=development
