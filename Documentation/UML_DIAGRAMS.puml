    component "Prometheus\n(30s Scrape Interval)" as prometheus
    component "Time-Series Database\n(30-Day Retention)" as tsdb
}

package "Visualization & Alerting" {
    component "Grafana\nDashboards" as grafana
    component "Alert Rules\n(Threshold-Based)" as alerts
}

package "Health Monitoring" {
