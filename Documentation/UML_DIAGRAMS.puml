@startuml Class_Diagram
!theme plain
skinparam classBackgroundColor #E1F5FF
skinparam classBorderColor #01579B
skinparam classArrowColor #01579B

' ============== ENTITIES ==============

class User {
    - user_id: Long
    - username: String
    - email: String
    - password_hash: String
    - roles: Set<String>
    - is_active: boolean
    - created_at: DateTime
    - updated_at: DateTime
    --
    + authenticate(password): boolean
    + hasRole(role): boolean
    + updateProfile(email): void
}

class AuditLog {
    - audit_id: Long
    - user_id: Long (FK)
    - action: String
    - resource_type: String
    - resource_id: Long
    - details: String
    - ip_address: String
    - timestamp: DateTime
    --
    + logAction(): void
    + getDetails(): String
}

class Account {
    - account_id: Long
    - user_id: Long (FK)
    - account_number: String
    - account_type: AccountType
    - balance: BigDecimal
    - currency: String
    - status: AccountStatus
    - created_at: DateTime
    --
    + getBalance(): BigDecimal
    + canTransfer(amount): boolean
    + debit(amount): void
    + credit(amount): void
    + freeze(): void
}

class Transaction {
    - transaction_id: Long
    - source_account_id: Long (FK)
    - destination_account_id: Long (FK)
    - amount: BigDecimal
    - currency: String
    - status: TransactionStatus
    - description: String
    - reference_id: String
    - timestamp: DateTime
    --
    + execute(): boolean
    + validate(): boolean
    + rollback(): void
    + getStatus(): TransactionStatus
}

class TransactionEvent {
    - event_id: Long
    - transaction_id: Long
    - event_type: String
    - amount: BigDecimal
    - timestamp: DateTime
    - is_processed: boolean
    --
    + toJson(): String
    + publish(): void
}

' ============== SERVICES ==============

class AuthService {
    - userRepository: UserRepository
    - jwtTokenProvider: JwtTokenProvider
    --
    + login(username, password): JwtToken
    + register(username, email, password): User
    + validateToken(token): boolean
    + refreshToken(token): JwtToken
    + logout(token): void
}

class AccountService {
    - accountRepository: AccountRepository
    - userRepository: UserRepository
    --
    + getAccountsByUser(userId): List
    + getAccountBalance(accountId): BigDecimal
    + createAccount(userId, accountType): Account
    + freezeAccount(accountId): void
    + getTransactionHistory(accountId): List
}

class TransactionService {
    - transactionRepository: TransactionRepository
    - accountService: AccountService
    - eventPublisher: EventPublisher
    --
    + transfer(fromId, toId, amount): Transaction
    + validateTransfer(from, to, amount): boolean
    + executeTransfer(transaction): boolean
    + rollbackTransfer(transaction): void
}

class NotificationService {
    - emailService: EmailService
    - eventListener: EventListener
    --
    + onTransferEvent(event): void
    + sendEmailNotification(user, subject): void
    + sendSmsNotification(phone, message): void
}

' ============== REPOSITORIES ==============

interface UserRepository {
    + findById(id): User
    + findByUsername(username): User
    + save(user): User
    + delete(id): void
}

interface AccountRepository {
    + findById(id): Account
    + findByUser(userId): List
    + save(account): Account
}

interface TransactionRepository {
    + findById(id): Transaction
    + findByAccount(accountId): List
    + save(transaction): Transaction
}

' ============== ENUMS ==============

enum AccountType {
    CHECKING
    SAVINGS
    INVESTMENT
    BUSINESS
}

enum AccountStatus {
    ACTIVE
    FROZEN
    CLOSED
    PENDING
}

enum TransactionStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    ROLLBACK
}

' ============== SECURITY ==============

class JwtTokenProvider {
    - secret: String
    - expirationTime: Long
    --
    + generateToken(userId, roles): String
    + validateToken(token): boolean
    + getUserIdFromToken(token): Long
}

class PasswordEncoder {
    --
    + encode(password): String
    + matches(rawPassword, encoded): boolean
}

' ============== RELATIONSHIPS ==============

User "1" --> "*" Account : owns
User "1" --> "*" AuditLog : generates
Account "1" --> "*" Transaction : source
Account "1" --> "*" Transaction : destination
Transaction "1" --> "1" TransactionEvent : triggers

AuthService --> UserRepository
AccountService --> AccountRepository
TransactionService --> TransactionRepository
TransactionService --> AccountService
NotificationService --> TransactionEvent

Account --> AccountType
Account --> AccountStatus
Transaction --> TransactionStatus

JwtTokenProvider --> PasswordEncoder
AuthService --> JwtTokenProvider

@enduml
