}

auth_metrics --> prometheus: HTTP GET\n(30s interval)
account_metrics --> prometheus: HTTP GET
transaction_metrics --> prometheus: HTTP GET
notification_metrics --> prometheus: HTTP GET
rabbitmq_metrics --> prometheus: HTTP GET
pg_exporter --> prometheus: HTTP GET

prometheus --> tsdb: Store Metrics

tsdb --> grafana: Query Data\n(Visualization)
tsdb --> alerts: Evaluate Rules\n(Real-time)

docker_health --> prometheus: Container Status
app_health --> prometheus: Application Status

logging --> log_agg: Stream Logs
log_agg --> alerts: Pattern Detection

alerts --> slack: Send Alert\n(Threshold Triggered)
alerts --> email: Send Alert

@enduml

@startuml Security_Layers
!theme plain
package "Layer 1: Perimeter Security" {
    component "DDoS Protection\n(ISP/CDN)" as ddos
    component "Firewall Rules\n(Allow 22, 80, 443)" as firewall
}

package "Layer 2: Transport Security" {
    component "TLS 1.2+\nEncryption" as tls
    component "OCSP Stapling" as ocsp
    component "Certificate Pinning" as pinning
}

package "Layer 3: API Gateway" {
    component "NGINX Reverse Proxy" as nginx
    component "Rate Limiting\n(5/s auth, 100/s API)" as ratelimit
    component "ModSecurity WAF" as waf
}

package "Layer 4: Application Security" {
    component "JWT Validation\n(HMAC-SHA512)" as jwt
    component "RBAC Authorization" as rbac
    component "Input Validation" as input_val
    component "SQL Parameterization" as sql_param
}

package "Layer 5: Data Security" {
    component "Encryption at Rest\n(LUKS/dm-crypt)" as encrypt_rest
    component "Network Isolation\n(Private VPC/Docker)" as isolation
    component "Secrets Management\n(Env Variables)" as secrets
}

package "Layer 6: Infrastructure Security" {
    component "Non-Root Containers\n(UID 1000+)" as nonroot
    component "Resource Limits\n(CPU, Memory)" as limits
    component "Signed Images" as signing
}

package "Layer 7: Monitoring & Response" {
    component "Audit Logging\n(All Actions)" as audit
    component "Security Alerts\n(Real-time)" as sec_alerts
    component "Incident Response\n(Playbooks)" as response
}

ddos --> firewall: Filtered Traffic
firewall --> tls: Allowed Port 443
tls --> ocsp: Certificate Validation
tls --> nginx: Encrypted Connection
nginx --> ratelimit: All Requests
ratelimit --> waf: Rate Check Pass
waf --> jwt: WAF Validation Pass
jwt --> rbac: Token Valid
rbac --> input_val: Authorized User
input_val --> sql_param: Clean Input
sql_param --> encrypt_rest: Secure Query
encrypt_rest --> isolation: Data Protection
isolation --> secrets: Isolated Network
secrets --> nonroot: Secret Injection
nonroot --> limits: Container Execution
limits --> audit: Action Logged
audit --> sec_alerts: Security Event
sec_alerts --> response: Alert Triggered

@enduml

@startuml Backup_Recovery
!theme plain
rectangle "Daily Backup Process" {
    component "Cron Scheduler\n(2 AM UTC)" as cron
    component "pg_dump\nAll 3 Databases" as pgdump
    component "Config Backup\n(.env, docker-compose)" as config_backup
    component "SSL Certificate\nBackup" as ssl_backup
    component "gzip Compression\nLevel 6" as gzip
    component "Timestamped\nDirectory\n(/backups/banking/\nYYYY-MM-DD_HH-MM-SS/)" as backup_store
    component "30-Day\nRetention\nCleanup" as cleanup
}

rectangle "Disaster Recovery Process" {
    component "Manual Trigger\nrestore-db.sh" as restore_trigger
    component "Select Backup\nDirectory" as select_backup
    component "gzip\nDecompression" as gunzip
    component "Drop Current\nDatabase" as drop_db
    component "Import SQL\nDump" as import_sql
    component "Verify Data\nIntegrity" as verify
    component "Update\nApplication\nState" as update_app
    component "Production\nServices Running" as running
}

cron --> pgdump: Trigger at 2 AM
pgdump --> config_backup: Database Backup\nComplete
config_backup --> ssl_backup: Configuration\nBackup Complete
ssl_backup --> gzip: Certificate\nBackup Complete
gzip --> backup_store: Compress All Files
backup_store --> backup_store: Store as\nauth_db.sql.gz\naccount_db.sql.gz\ntransaction_db.sql.gz
backup_store --> cleanup: Write Timestamp
cleanup --> cleanup: Auto-Delete Backups\nOlder than 30 Days

restore_trigger --> select_backup: User Selection
select_backup --> gunzip: Load Backup Files
gunzip --> drop_db: Decompress
drop_db --> import_sql: Drop Structures
import_sql --> verify: Import SQL
verify --> update_app: Data Validation Pass
update_app --> running: Database Online

@enduml

