@startuml System_Architecture
!theme plain
skinparam backgroundColor #FEFEFE
skinparam component {
    BackgroundColor<<service>> #E1F5FF
    BackgroundColor<<database>> #FFF3E0
    BackgroundColor<<queue>> #F3E5F5
    BackgroundColor<<monitoring>> #E8F5E9
    BackgroundColor<<infrastructure>> #F5F5F5
    BorderColor #424242
}

package "Client Tier" {
    actor "End User" as user
    component "Web Browser" as browser
}

package "API Gateway & Security" {
    component "NGINX Reverse Proxy\n(Port 80/443)" as nginx <<infrastructure>>
    component "ModSecurity WAF" as waf <<infrastructure>>
    component "TLS 1.2+\nLet's Encrypt" as tls <<infrastructure>>
}

package "Microservices" {
    component "Auth Service\n(Port 8081)" as auth <<service>>
    component "Account Service\n(Port 8082)" as account <<service>>
    component "Transaction Service\n(Port 8083)" as transaction <<service>>
    component "Notification Service\n(Port 8084)" as notification <<service>>
    component "Frontend\nReact + Vite" as frontend <<service>>
}

package "Data Layer" {
    database "PostgreSQL\nauth_db" as db_auth <<database>>
    database "PostgreSQL\naccount_db" as db_account <<database>>
    database "PostgreSQL\ntransaction_db" as db_transaction <<database>>
}

package "Message Queue" {
    component "RabbitMQ\n(Port 5672)" as rabbitmq <<queue>>
}

package "Monitoring & Observability" {
    component "Prometheus\n(Metrics)" as prometheus <<monitoring>>
    component "Grafana\n(Dashboards)" as grafana <<monitoring>>
    component "Health Checks" as health <<monitoring>>
}

package "Infrastructure" {
    component "Docker Compose\nOrchestration" as docker <<infrastructure>>
    component "Backup & Recovery\nSystem" as backup <<infrastructure>>
    component "Cron Scheduler\n(Daily 2 AM)" as cron <<infrastructure>>
}

package "CI/CD Pipeline" {
    component "GitLab\nRepository" as gitlab <<infrastructure>>
    component "Build Pipeline\n(Lint/Build/Push)" as pipeline <<infrastructure>>
    component "Deploy Pipeline\n(Staging/Prod)" as deploy <<infrastructure>>
}

user --> browser: HTTP/HTTPS Requests
browser --> nginx: Requests
nginx --> waf: Security Check
waf --> tls: Encrypted Channel
tls --> frontend: Static Content\n(SPA)
tls --> nginx: Forward
nginx --> auth: /api/auth/*\n(Rate Limited 5/s)
nginx --> account: /api/accounts/*\n(Rate Limited 100/s)
nginx --> transaction: /api/transactions/*\n(Rate Limited 100/s)

auth --> db_auth: User Credentials\n& Audit Logs
account --> db_account: Account Data\n& Balance
transaction --> db_transaction: Transfers\n& Ledger
transaction --> rabbitmq: TransferEvent\nPublished
notification --> rabbitmq: Events\nConsumed
notification --> auth: Send Email\nNotification

auth --> health: Health Check
account --> health: Health Check
transaction --> health: Health Check
notification --> health: Health Check

prometheus --> auth: Scrape Metrics\n(30s interval)
prometheus --> account: Scrape Metrics
prometheus --> transaction: Scrape Metrics
prometheus --> notification: Scrape Metrics
prometheus --> rabbitmq: Scrape Metrics
prometheus --> db_auth: Scrape Metrics\n(exporter)
prometheus --> db_account: Scrape Metrics
prometheus --> db_transaction: Scrape Metrics

grafana --> prometheus: Query Metrics\n(Visualization)
grafana --> health: Display Status

docker --> auth: Orchestrate
docker --> account: Orchestrate
docker --> transaction: Orchestrate
docker --> notification: Orchestrate
docker --> frontend: Orchestrate
docker --> db_auth: Manage Volume
docker --> db_account: Manage Volume
docker --> db_transaction: Manage Volume
docker --> rabbitmq: Orchestrate
docker --> prometheus: Orchestrate
docker --> grafana: Orchestrate

cron --> backup: Trigger Daily\nBackup (2 AM)
backup --> db_auth: Dump auth_db
backup --> db_account: Dump account_db
backup --> db_transaction: Dump transaction_db

gitlab --> pipeline: Push Triggers
pipeline --> docker: Build Images
docker --> deploy: Update Images
deploy --> nginx: Rolling Update

@enduml

@startuml Authentication_Sequence
!theme plain
participant "Web Client" as client
participant "API Gateway\n(NGINX)" as gateway
participant "Auth Service" as auth
database "auth_db" as db
participant "Account Service" as account

autonumber
client --> gateway: POST /api/auth/login\n{username, password}
gateway --> auth: Forward Request\n+ Security Check
auth --> db: Query User by\nUsername
db --> auth: Return User Record\n(Password Hash)
auth --> auth: Verify Password\n(BCrypt Compare)
auth --> auth: Generate JWT\n(HMAC-SHA512)
auth --> db: Log Audit Event\n(Login Attempt)
auth --> gateway: Return JWT Token\n+ Expiration
gateway --> client: 200 OK\n{token, expires_in}
client --> gateway: GET /api/accounts\nHeader: Authorization: Bearer <JWT>
gateway --> gateway: Validate JWT\nSignature & Expiry
gateway --> account: Forward Request\n+ User Context
account --> account: Authorize Request\n(Check Roles)
account --> db: Query User Accounts
db --> account: Return Accounts\nList
account --> gateway: Return Accounts\nData
gateway --> client: 200 OK\n{accounts: [...]]}

@enduml

@startuml Transfer_Transaction_Sequence
!theme plain
participant "Web Client" as client
participant "API Gateway" as gateway
participant "Transaction Service" as transaction
database "transaction_db" as txdb
database "account_db" as accdb
participant "Account Service" as account
participant "RabbitMQ" as rabbitmq
participant "Notification Service" as notification

autonumber
client --> gateway: POST /api/transactions/transfer\n{from, to, amount}
gateway --> transaction: Forward Request\n+ JWT Validation
transaction --> transaction: Validate Request\n(Schema, Amount > 0)
transaction --> accdb: Lock Source Account\n(Row-Level Lock)
transaction --> accdb: Query Source Balance
accdb --> transaction: Return Balance
transaction --> transaction: Check Balance\n>= Amount
transaction --> accdb: Debit Source\nAccount
transaction --> accdb: Lock Target Account\n(Row-Level Lock)
transaction --> accdb: Credit Target\nAccount
transaction --> txdb: Create Transaction\nRecord (PENDING)
transaction --> txdb: Update Status\nto COMPLETED
transaction --> rabbitmq: Publish TransferEvent\n{from, to, amount, timestamp}
rabbitmq --> transaction: Event Acknowledged
transaction --> gateway: Return 201 Created\n{transaction_id, status}
gateway --> client: 201 Created\n{transaction_id}
rabbitmq --> notification: Consume TransferEvent\n(Async)
notification --> notification: Generate Email\nMessage
notification --> notification: Send Email\nNotification
notification --> transaction: Log Notification\nSent

@enduml

@startuml CI_CD_Pipeline
!theme plain
actor "Developer" as dev
participant "GitLab Repository" as gitlab
participant "Pipeline Trigger" as trigger
participant "Lint Stage" as lint
participant "Build Stage\n(5 parallel)" as build
participant "Docker Registry" as registry
participant "Deploy Staging" as stage_deploy
participant "Staging VPS" as stage_vps
participant "Deploy Production" as prod_deploy
participant "Production VPS" as prod_vps
participant "Slack Notification" as slack

autonumber
dev --> gitlab: git push origin develop\n(or main for prod)
gitlab --> trigger: Webhook Triggers\nPipeline
trigger --> lint: Start Lint Job
lint --> lint: Validate docker-compose.prod.yml\nYAML Syntax
lint --> trigger: Lint Passed\n(or Failed)
trigger --> build: Start 5 Build Jobs\n(Parallel)
build --> build: build:auth-service\nbuild:account-service\nbuild:transaction-service\nbuild:notification-service\nbuild:frontend
build --> build: docker build\n+ Metadata (BUILD_DATE, VCS_REF, VERSION)
build --> registry: docker push\n<REGISTRY>/<service>:<TAG>
registry --> build: Image Pushed\nSuccessfully
build --> trigger: All Builds Complete
trigger --> stage_deploy: Start Deploy Staging\n(if develop branch)
stage_deploy --> stage_vps: SSH to Staging\n(STAGING_HOST)
stage_vps --> stage_vps: Backup Database\n(pg_dump all 3 DBs)
stage_vps --> stage_vps: Update .env\nIMAGE_TAG
stage_vps --> stage_vps: docker-compose pull\n(Latest Images)
stage_vps --> stage_vps: docker-compose up -d\n(Rolling Update)
stage_vps --> stage_vps: Wait 30s for\nStabilization
stage_vps --> stage_deploy: Health Checks:\nAll Services Running
stage_deploy --> trigger: Deploy Staging\nSuccessful
trigger --> prod_deploy: Start Deploy Production\n(if main/tags branch)
prod_deploy --> prod_vps: SSH to Production\n(PRODUCTION_HOST)
prod_vps --> prod_vps: CRITICAL: Backup Database\n(pg_dump + gzip)
prod_vps --> prod_vps: Update .env\nIMAGE_TAG
prod_vps --> prod_vps: docker-compose pull\n(Latest Images)
prod_vps --> prod_vps: docker-compose up -d\n(Rolling Update)
prod_vps --> prod_vps: Wait 40s for\nStabilization
prod_vps --> prod_vps: Health Checks Loop:\n5 Attempts (5s intervals)
prod_vps --> prod_vps: If Health Check Fails:\nAuto-Rollback from Backup
prod_deploy --> slack: Notify Success\n(Commit SHA, Author, Branch)
prod_deploy --> trigger: Deployment Complete

@enduml

@startuml Database_Schema
!theme plain
entity "Users" {
    * user_id : INTEGER
    --
    username : VARCHAR(100)
    email : VARCHAR(255)
    password_hash : VARCHAR(255)
    roles : VARCHAR(50)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity "AuditLogs" {
    * audit_id : INTEGER
    --
    user_id : INTEGER (FK)
    action : VARCHAR(100)
    resource : VARCHAR(100)
    details : TEXT
    timestamp : TIMESTAMP
}

entity "Accounts" {
    * account_id : INTEGER
    --
    user_id : INTEGER (FK)
    account_number : VARCHAR(20)
    account_type : VARCHAR(50)
    balance : DECIMAL(15,2)
    currency : VARCHAR(3)
    status : VARCHAR(20)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity "Transactions" {
    * transaction_id : INTEGER
    --
    source_account_id : INTEGER (FK)
    destination_account_id : INTEGER (FK)
    amount : DECIMAL(15,2)
    currency : VARCHAR(3)
    status : VARCHAR(20)
    description : TEXT
    timestamp : TIMESTAMP
}

Users ||--o{ AuditLogs : "generates"
Users ||--o{ Accounts : "owns"
Accounts ||--o{ Transactions : "source"
Accounts ||--o{ Transactions : "destination"

@enduml

@startuml Service_Deployment
!theme plain
cloud "Docker Compose\nProduction Cluster" {
    node "NGINX Container" {
        component "Reverse Proxy\nPort: 80/443" as nginx
    }

    node "Auth Service Container" {
        component "Spring Boot App\nPort: 8081" as auth
    }

    node "Account Service Container" {
        component "Spring Boot App\nPort: 8082" as account
    }

    node "Transaction Service Container" {
        component "Spring Boot App\nPort: 8083" as transaction
    }

    node "Notification Service Container" {
        component "Spring Boot App\nPort: 8084" as notification
    }

    node "Frontend Container" {
        component "React App\nPort: 3000" as frontend
    }

    node "PostgreSQL Auth Container" {
        database "auth_db\nVolume: /var/lib/postgresql" as auth_db
    }

    node "PostgreSQL Account Container" {
        database "account_db\nVolume: /var/lib/postgresql" as account_db
    }

    node "PostgreSQL Transaction Container" {
        database "transaction_db\nVolume: /var/lib/postgresql" as transaction_db
    }

    node "RabbitMQ Container" {
        component "Message Broker\nPort: 5672/15672" as rabbitmq
    }

    node "Prometheus Container" {
        component "Metrics Collector\nPort: 9090" as prometheus
    }

    node "Grafana Container" {
        component "Visualization\nPort: 3000" as grafana
    }

    node "Certbot Container" {
        component "SSL/TLS Renewal\nVolume: /etc/letsencrypt" as certbot
    }

    nginx --> auth: Forward /api/auth/*
    nginx --> account: Forward /api/accounts/*
    nginx --> transaction: Forward /api/transactions/*
    nginx --> frontend: Serve Static
    
    auth --> auth_db: Query/Update
    account --> account_db: Query/Update
    transaction --> transaction_db: Query/Update
    
    transaction --> rabbitmq: Publish Events
    notification --> rabbitmq: Consume Events
    
    auth --> prometheus: Metrics
    account --> prometheus: Metrics
    transaction --> prometheus: Metrics
    notification --> prometheus: Metrics
    rabbitmq --> prometheus: Metrics
    
    prometheus --> grafana: Provide Metrics
}

node "Docker Network\n(banking-network)" {
    component "Bridge Network\nSubnet: 172.20.0.0/16" as network
}

@enduml

